{
  "info": {
    "_postman_id": "reitera-api-collection-v1",
    "name": "Reitera API",
    "description": "Complete REST API collection for the Reitera spaced repetition application.\n\n**Setup:**\n1. Import this collection into Postman.\n2. Set the `base_url` variable to `http://localhost:8080` (already set by default).\n3. Run **Login (alumno)** — the token is saved automatically to the `token` variable.\n4. All protected endpoints will use that token automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Public endpoints for user registration and login. No token required.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test01\",\n  \"email\": \"test01@test.com\",\n  \"password\": \"!Test123\",\n  \"confirmPassword\": \"!Test123\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Testez\"\n}"
            },
            "description": "Creates a new user account. Returns the created user data (no password). Password must be at least 8 characters with 1 digit, 1 lowercase, 1 uppercase and 1 special character."
          },
          "response": []
        },
        {
          "name": "Login (alumno)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonResponse = pm.response.json();",
                  "if (jsonResponse.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonResponse.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', jsonResponse.refreshToken);",
                  "    console.log('Access token and refresh token saved.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alumno@reitera.com\",\n  \"password\": \"reitera2026\"\n}"
            },
            "description": "Authenticates the seed demo user and saves the JWT to the `token` collection variable. Password: reitera2026."
          },
          "response": []
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonResponse = pm.response.json();",
                  "if (jsonResponse.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonResponse.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', jsonResponse.refreshToken);",
                  "    console.log('Access token and refresh token saved.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@reitera.com\",\n  \"password\": \"reitera2026\"\n}"
            },
            "description": "Authenticates the seed admin user. Useful to verify that admin has no decks and returns empty lists."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonResponse = pm.response.json();",
                  "if (jsonResponse.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonResponse.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', jsonResponse.refreshToken);",
                  "    console.log('Tokens rotated and saved.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "description": "Exchanges the current refresh token for a new access token and a rotated refresh token. The old refresh token is revoked. Both new tokens are saved automatically to collection variables."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "description": "Revokes all active refresh tokens for the user. Returns 204 No Content. The access token will continue to work until its 15-minute TTL expires."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "description": "User profile endpoints. All endpoints require a valid JWT token (Bearer).",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Returns the profile of the authenticated user: id, username, email, firstName, lastName, roleName. No password included."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "description": "Category endpoints. Returns only categories used in the authenticated user's own decks.",
      "item": [
        {
          "name": "Get My Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "categories"]
            },
            "description": "Returns the distinct categories used across all decks owned by the authenticated user. With seed data (alumno): Historia de España, Programación Java, Inglés B2."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tags",
      "description": "Tag endpoints. Returns only tags used on cards in the authenticated user's decks.",
      "item": [
        {
          "name": "Get My Tags",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tags",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tags"]
            },
            "description": "Returns the distinct tags assigned to cards in the authenticated user's decks. With seed data (alumno): importante, difícil, vocabulario. Note: 'repaso' exists in the DB but is not assigned to any card, so it will NOT appear here."
          },
          "response": []
        },
        {
          "name": "Get Cards by Tag",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tags/1/cards?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tags", "1", "cards"],
              "query": [
                { "key": "page", "value": "0", "description": "Zero-based page number" },
                { "key": "size", "value": "20", "description": "Items per page" }
              ]
            },
            "description": "Returns a paginated list of cards owned by the authenticated user that have the specified tag. Replace '1' with the actual tag ID from 'Get My Tags'. Always returns 200 — returns an empty page for unknown tag IDs to prevent enumeration."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Decks",
      "description": "CRUD operations for study decks. All endpoints require a valid JWT token (Bearer).",
      "item": [
        {
          "name": "Create Deck",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Historia de España\",\n  \"description\": \"Repaso de eventos clave del siglo XX\",\n  \"isPublic\": false,\n  \"categoryId\": null\n}"
            },
            "description": "Creates a new deck owned by the authenticated user. `categoryId` is optional — send `null` or omit it if no category applies."
          },
          "response": []
        },
        {
          "name": "Get My Decks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks?page=0&size=20&sort=createdAt,desc",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks"],
              "query": [
                { "key": "page", "value": "0", "description": "Zero-based page number" },
                { "key": "size", "value": "20", "description": "Items per page" },
                { "key": "sort", "value": "createdAt,desc", "description": "Sort field and direction" }
              ]
            },
            "description": "Returns a paginated list of decks owned by the authenticated user. Response is a Page object with 'content', 'totalElements', 'totalPages', 'number', and 'size' fields."
          },
          "response": []
        },
        {
          "name": "Get Deck by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1"]
            },
            "description": "Returns a single deck by its ID. Returns 404 if not found or if the authenticated user is not the owner."
          },
          "response": []
        },
        {
          "name": "Update Deck",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Historia de España (Actualizado)\",\n  \"description\": \"Versión revisada con más contenido\",\n  \"isPublic\": true,\n  \"categoryId\": null\n}"
            },
            "description": "Updates an existing deck. Only the owner can perform this operation. Replaces all fields (full update)."
          },
          "response": []
        },
        {
          "name": "Delete Deck",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1"]
            },
            "description": "Deletes a deck by ID. Only the owner can perform this operation. Returns HTTP 204 (No Content) on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cards",
      "description": "CRUD operations for flashcards. Cards are always nested under a parent deck. All endpoints require a valid JWT token (Bearer).",
      "item": [
        {
          "name": "Create Card (BASIC)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1/cards",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1", "cards"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"BASIC\",\n  \"question\": \"¿En qué año comenzó la Guerra Civil Española?\",\n  \"answerJson\": {\n    \"answer\": \"1936\"\n  },\n  \"explanation\": \"El conflicto se inició el 17 de julio de 1936 con el alzamiento militar.\",\n  \"tagIds\": []\n}"
            },
            "description": "Creates a BASIC card (question / answer). `answerJson` for this type must contain a single `answer` key."
          },
          "response": []
        },
        {
          "name": "Create Card (MULTIPLE_CHOICE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1/cards",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1", "cards"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MULTIPLE_CHOICE\",\n  \"question\": \"¿Cuál fue el bando vencedor de la Guerra Civil Española?\",\n  \"answerJson\": {\n    \"options\": [\"Bando Republicano\", \"Bando Nacional\", \"Ninguno\"],\n    \"correctIndex\": 1\n  },\n  \"explanation\": \"El bando Nacional, liderado por Francisco Franco, venció en 1939.\",\n  \"tagIds\": []\n}"
            },
            "description": "Creates a MULTIPLE_CHOICE card. `answerJson` must contain `options` (array of strings) and `correctIndex` (0-based index of the correct option)."
          },
          "response": []
        },
        {
          "name": "Create Card (CLOZE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1/cards",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1", "cards"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CLOZE\",\n  \"question\": \"La Guerra Civil Española terminó en el año ___.\",\n  \"answerJson\": {\n    \"answer\": \"1939\"\n  },\n  \"explanation\": null,\n  \"tagIds\": []\n}"
            },
            "description": "Creates a CLOZE (fill-in-the-blank) card. Use ___ in the question to mark the gap. `answerJson` must contain a single `answer` key with the word or phrase that fills the blank."
          },
          "response": []
        },
        {
          "name": "Create Card (TRUE_FALSE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1/cards",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1", "cards"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TRUE_FALSE\",\n  \"question\": \"La Guerra Civil Española comenzó en 1936.\",\n  \"answerJson\": {\n    \"answer\": true\n  },\n  \"explanation\": \"El alzamiento militar comenzó el 17 de julio de 1936.\",\n  \"tagIds\": []\n}"
            },
            "description": "Creates a TRUE_FALSE card. `answerJson` must contain a single boolean `answer` key."
          },
          "response": []
        },
        {
          "name": "Get Cards by Deck",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1/cards?page=0&size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1", "cards"],
              "query": [
                { "key": "page", "value": "0", "description": "Zero-based page number" },
                { "key": "size", "value": "20", "description": "Items per page" }
              ]
            },
            "description": "Returns a paginated list of cards belonging to the specified deck. Only accessible by the deck owner. Response is a Page object with 'content', 'totalElements', 'totalPages', 'number', and 'size' fields."
          },
          "response": []
        },
        {
          "name": "Get Card by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1/cards/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1", "cards", "1"]
            },
            "description": "Returns a single card by its ID within the specified deck. Returns 404 if the card does not exist or does not belong to the deck."
          },
          "response": []
        },
        {
          "name": "Update Card",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1/cards/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1", "cards", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"BASIC\",\n  \"question\": \"¿En qué año terminó la Guerra Civil Española?\",\n  \"answerJson\": {\n    \"answer\": \"1939\"\n  },\n  \"explanation\": \"El conflicto finalizó el 1 de abril de 1939.\",\n  \"tagIds\": []\n}"
            },
            "description": "Updates an existing card. Only the deck owner can perform this operation. Replaces all fields (full update)."
          },
          "response": []
        },
        {
          "name": "Delete Card",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/decks/1/cards/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "decks", "1", "cards", "1"]
            },
            "description": "Deletes a card by ID. Only the deck owner can perform this operation. Returns HTTP 204 (No Content) on success."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Study",
      "description": "FSRS-6 spaced repetition study endpoints. Fetch due cards and submit session ratings. All endpoints require a valid JWT token (Bearer).",
      "item": [
        {
          "name": "Get Due Cards (by Deck)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/study/due?deckId=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "study", "due"],
              "query": [
                { "key": "deckId", "value": "1" }
              ]
            },
            "description": "Returns all cards due for review in a single deck. Includes overdue cards (nextReview <= now) and new cards (no StudyProgress yet). The 'state' field indicates: 0=New, 1=Learning, 2=Review, 3=Relearning."
          },
          "response": []
        },
        {
          "name": "Get Due Cards (by Category)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/study/due?categoryId=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "study", "due"],
              "query": [
                { "key": "categoryId", "value": "1" }
              ]
            },
            "description": "Returns all due cards across every deck the user owns within a category. With seed data (alumno + categoryId=1 Historia de España): returns cards from both SGMU and GCE decks."
          },
          "response": []
        },
        {
          "name": "Submit Session (by Deck)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/study/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "study", "sessions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deckId\": 1,\n  \"categoryId\": null,\n  \"ratings\": [\n    { \"cardId\": 1, \"rating\": 3 },\n    { \"cardId\": 2, \"rating\": 1 },\n    { \"cardId\": 3, \"rating\": 4 }\n  ]\n}"
            },
            "description": "Submits all card ratings from a completed session. The FSRS-6 algorithm computes the next review date for each card. Rating scale: 1=Again, 2=Hard, 3=Good, 4=Easy. The entire batch is processed in a single transaction."
          },
          "response": []
        },
        {
          "name": "Submit Session (by Category)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/study/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "study", "sessions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deckId\": null,\n  \"categoryId\": 1,\n  \"ratings\": [\n    { \"cardId\": 4, \"rating\": 3 },\n    { \"cardId\": 5, \"rating\": 2 }\n  ]\n}"
            },
            "description": "Same as 'Submit Session (by Deck)' but for category-scope sessions. Use when the due cards were fetched with categoryId. Validates that all rated cards belong to a deck in the declared category owned by the user."
          },
          "response": []
        }
      ]
    }
  ]
}
